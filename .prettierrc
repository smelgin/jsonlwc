{
  "trailingComma": "none",
  "tabWidth": 4,
  "singleQuote": true,
  "endOfLine": "auto",
  "plugins": ["prettier-plugin-apex"],
  "overrides": [
    {
      "files": "*.{cls,trigger}",
      "options": { "tabWidth": 2 }
    },
    {
      "files": "*.{json,yaml,yml}",
      "options": { "tabWidth": 2 }
    },
    {
      "files": "**/lwc/**/*.html",
      "options": { "parser": "lwc" }
    },
    {
      "files": "*.{cmp,page,component}",
      "options": { "parser": "html" }
    }
  ]
}
